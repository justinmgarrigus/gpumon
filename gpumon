class Style:
    def __init__(self):
        on = (sys.stdout.isatty() and "NO_COLOR" not in os.environ
              and os.environ.get("TERM", "") != "dumb")
        self.on = on
        self.truecolor = on and os.environ.get("COLORTERM", "") in ("truecolor", "24bit")

    def sgr(self, code, text):
        return "\033[%sm%s\033[0m" % (code, text) if self.on else text

    def bold(self, t):
        return self.sgr("1", t)

    def dim(self, t):
        return self.sgr("2", t)

    def warn(self, t):
        return self.sgr("33", t)

    def claim(self, t):
        """Highlight for claimed GPUs: bold white on magenta."""
        return self.sgr("1;97;45", t)

    # 0 (nothing on the GPU) is a dark navy; anything above 0 starts at a
    # clearly different brown and brightens through amber to pale yellow, so
    # 1% never looks like 0%.
    ZERO_RGB, ZERO_256 = (28, 38, 74), 17
    RAMP_RGB = [(150, 70, 15), (190, 95, 20), (220, 125, 30), (238, 158, 50),
                (248, 192, 90), (252, 222, 150), (255, 244, 215)]
    RAMP_256 = [130, 166, 172, 208, 214, 220, 221, 222, 229]

    def level_color(self, frac):
        frac = min(1.0, max(0.0, frac))
        if frac == 0:
            return "38;2;%d;%d;%d" % self.ZERO_RGB if self.truecolor else "38;5;%d" % self.ZERO_256
        if self.truecolor:
            x = frac * (len(self.RAMP_RGB) - 1)
            i = min(int(x), len(self.RAMP_RGB) - 2)
            t = x - i
            a, b = self.RAMP_RGB[i], self.RAMP_RGB[i + 1]
            r, g, bl = (round(a[k] + (b[k] - a[k]) * t) for k in range(3))
            return "38;2;%d;%d;%d" % (r, g, bl)
        return "38;5;%d" % self.RAMP_256[min(len(self.RAMP_256) - 1, int(frac * len(self.RAMP_256)))]

    SHADES = " ░▒▓█"

    def cell(self, frac, held=None):
        """One heatmap character for a value in [0,1], or None = no data.
        held: True = a process holds the GPU (drawn as at least 1%),
        False = none does (drawn as 0), None = unknown (value as is)."""
        if frac is None:
            return self.dim("·")
        if held is not None:
            frac = max(frac, 0.01) if held else 0.0
        if self.on:
            return self.sgr(self.level_color(frac), "█")
        return self.SHADES[0] if frac <= 0 else self.SHADES[min(4, max(1, int(round(frac * 4))))]

    def legend(self):
        steps = [0, 0.01, 0.2, 0.35, 0.5, 0.65, 0.8, 1.0]
        if self.on:
            bar = "".join(self.cell(s) * 2 for s in steps)
        else:
            bar = "".join(c * 2 for c in self.SHADES)
        return bar


METRICS = {
    # key: (label, row field, unit, scale-fn(gpu_info) -> max value)
    "util": ("GPU utilization", "util", "%", lambda g: 100.0),
}


def fmt_mem(mib):
    return "-" if mib is None else "%.1f" % (mib / 1024.0)


def fmt_pct(v):
    return "  -" if v is None else "%3.0f" % v


def term_width(args):
    return shutil.get_terminal_size((100, 24)).columns


def pick_ticks(start, end, ncols):
    """[(col, label)] for nicely spaced time ticks along a time axis."""
    span = end - start
    steps = [300, 600, 900, 1800, 3600, 7200, 3 * 3600, 6 * 3600, 12 * 3600, 86400, 2 * 86400, 7 * 86400]
    label_w = 6 if span <= 2 * 86400 else 9
    for step in steps:
        if ncols * step / span >= label_w + 3:
            break
    tz = time.localtime(end).tm_gmtoff
    t = (start + tz) // step * step - tz
    if t < start:
        t += step
    out = []
    while t < end:
        lt = time.localtime(t)
        if step >= 86400:
            label = time.strftime("%a %d", lt)
        elif span > 86400 and lt.tm_hour == 0 and lt.tm_min == 0:
            label = time.strftime("%a", lt)
        else:
            label = time.strftime("%H:%M", lt)
        out.append((int((t - start) * ncols / span), label))
        t += step
    return out


def time_axis(start, end, ncols, indent):
    marks = [" "] * ncols
    labels = [" "] * (ncols + 12)
    for col, label in pick_ticks(start, end, ncols):
        if col >= ncols:
            continue
        marks[col] = "╵"
        if col + len(label) <= ncols + 1 and all(c == " " for c in labels[max(0, col - 1):col + len(label) + 1]):
            labels[col:col + len(label)] = list(label)
    return [" " * indent + "".join(marks), " " * indent + "".join(labels).rstrip()]


def in_use(row):
    """Whether utilization / memory alone show the GPU in use (same limits as `gpumon free`)."""
    return (row.get("util") or 0) >= 5 or (row.get("mem") or 0) >= 1024


def heatmap(st, db, gpus, info, start, end, metric, width, title, occupancy=False, claims=()):
    """occupancy: draw buckets where the GPU was unused (no process seen, no
    real activity) as 0, and all others as at least 1%."""
    label_w = 7
    ncols = max(10, width - label_w - 1)
    span = end - start
    native = max(1, span // 60) if start >= end - MINUTE_RETENTION else max(1, span // 3600)
    nb = min(ncols, native)
    # Stretch the nb buckets over all ncols columns (some get one column more).
    col_bucket = [c * nb // ncols for c in range(ncols)]
    data = bucketed(db, start, end, nb)
    occupied = occupied_buckets(db, start, end, nb) if occupancy else None
    _, field, unit, scale = METRICS[metric]
    res = ("1 column = %s" if nb == ncols else "%s resolution") % fmt_bucket(span / nb)
    lines = [st.bold(title) + st.dim("   (%s)" % res)]
    for g in gpus:
        mx = scale(info.get(g, {}))
        row = data.get(g, [None] * nb)
        vals = [None if r is None or r[field] is None else r[field] / mx for r in row]
        if occupied is None:
            used = [None] * nb
        else:
            held = occupied.get(g, set())
            used = [b in held or (r is not None and in_use(r)) for b, r in enumerate(row)]
        cells = (st.cell(vals[b], used[b]) for b in col_bucket)
        label = "GPU %-2d " % g
        lines.append((st.claim(label) if g in claims else label) + " " + "".join(cells))
    lines += time_axis(start, end, ncols, label_w + 1)
    return lines


def fmt_bucket(secs):
    if secs < 90:
        return "%ds" % round(secs) if secs < 60 else "1 min"
    if secs < 5400:
        return "%d min" % round(secs / 60)
    if secs < 86400 * 1.5:
        return "%.1f h" % (secs / 3600)
    return "%.1f d" % (secs / 86400)


ANSI_RE = re.compile(r"\033\[[0-9;]*m")


def header(st, db, info, extra=""):
    names = sorted(set(v["name"] for v in info.values()))
    host = socket.gethostname()
    model = ", ".join("%d× %s" % (sum(1 for v in info.values() if v["name"] == n), n.replace("NVIDIA ", ""))
                      for n in names)
    ts, _ = latest(db)
    age = "no samples yet" if ts is None else "last sample %s ago" % ago(time.time() - ts - 60)
    stale = ts is None or time.time() - ts > 300
    line = "%s  %s  %s" % (st.bold("gpumon @ " + host), model, st.dim(time.strftime("%Y-%m-%d %H:%M")))
    out = [line + ("  " + extra if extra else "")]
    out.append((st.warn("⚠ collector looks stopped: " + age) if stale else st.dim(age)))
    return out


def ago(secs):
    secs = max(0, int(secs))
    if secs < 90:
        return "%ds" % secs
    if secs < 5400:
        return "%dm" % (secs // 60)
    if secs < 172800:
        return "%.1fh" % (secs / 3600)
    return "%.1fd" % (secs / 86400)


_DOMAIN_RE = re.compile(r"[@-][a-z0-9-]+(?:\.[a-z0-9-]+)*\.(?:edu|com|org|net|gov|io|local|lan|internal|[a-z]{2})(?=-|$)", re.I)


def short_owner(o, n=22):
    """Drop domain parts (user@example.edu, ctr:user-example.edu-job) and truncate."""
    o = _DOMAIN_RE.sub("", o)
    return o if len(o) <= n else o[:n - 1] + "…"


def current_owners(db, info):
    """{gpu: [owner, ...]} for processes on each GPU right now, largest first.
    Falls back to the collector's newest minute if nvidia-smi can't be run."""
    with contextlib.suppress(sqlite3.OperationalError):  # table appears on collector restart
        for cid, name in db.execute("SELECT cid, name FROM containers"):
            _container_names.setdefault(cid, name)
    procs = sample_processes({v["uuid"]: g for g, v in info.items()})
    if procs is not None:
        out = {}
        for (gpu, owner), _ in sorted(procs.items(), key=lambda kv: (kv[0][0], -kv[1])):
            out.setdefault(gpu, []).append(owner)
        return out
    ts = db.execute("SELECT MAX(ts) FROM minute").fetchone()[0]
    if ts is None or time.time() - ts > 300:
        return {}
    out = {}
    for gpu, owner in db.execute("SELECT gpu, owner FROM proc_minute WHERE ts = ? ORDER BY gpu, mem DESC", (ts,)):
        out.setdefault(gpu, []).append(owner)
    return out


def owner_cell(st, owners, w):
    """Comma-separated owners fitted and padded to exactly w visible columns."""
    txt = ", ".join(short_owner(o, w) for o in owners)
    if len(txt) > w:
        txt = txt[:w - 1] + "…"
    return (txt or st.dim("-")) + " " * (w - max(1, len(txt)))


def render_overview(args, st):
    db = open_ro(args)
    info = gpu_info(db)
    if not info:
        return header(st, db, info) + ["", "No GPUs recorded yet; the collector writes its first row after ~1 minute."]
    gpus = sorted(info)
    width = term_width(args)
    now = int(time.time())
    end = now // 60 * 60
    live = live_sample()
    _, last = latest(db)
    stats = {r: range_stats(db, end - s, end) for r, s in (("1h", 3600), ("24h", 86400), ("7d", 7 * 86400))}
    owners = owners_by_gpu(db, end - 3600, end)
    current = current_owners(db, info)
    claims = active_claims(args)
    out = header(st, db, info)
    out.append("")
    claim_w = 17
    row_fmt = "%s %s %4s %-9s │ %4s %4s %4s │ %4s %4s │ %s │ "
    head = row_fmt % ("GPU", " ", "now", "mem GiB", "1h", "24h", "7d", "24h", "7d", "claimed by".ljust(claim_w))
    user_w = max(len("users (last 1h)"), (width - len(head) - 3) // 2)
    out.append(st.dim(" " * 21 + "│ avg util       │ active    │"))
    out.append(st.bold(head + "users (last 1h)".ljust(user_w) + " │ users (current)"))
    for g in gpus:
        cur = (live or {}).get(g) or last.get(g) or {}
        u = cur.get("util")
        nowtxt = (fmt_pct(u) + "%") if u is not None else "   -"
        memtxt = "%4s/%-4.0f" % (fmt_mem(cur.get("mem")), info[g]["mem_total"] / 1024.0)
        avgs = [fmt_pct(stats[r].get(g, {}).get("util")) + "%" for r in ("1h", "24h", "7d")]
        act = ["%3s%%" % ("%.0f" % (100 * stats[r][g]["active"]) if g in stats[r] else "-")
               for r in ("24h", "7d")]
        nowcell = st.cell(None if u is None else u / 100.0, g in current or in_use(cur))
        c = claims.get(g)
        gid = "%-3d" % g
        if c:
            gid = st.claim(gid)
            claim = st.claim(("%s %s" % (short_owner(c["user"], claim_w - 7),
                                         fmt_left(c["expires"] - time.time()))).ljust(claim_w))
        else:
            claim = st.dim("-") + " " * (claim_w - 1)
        line = row_fmt % tuple([gid, nowcell, nowtxt, memtxt] + avgs + act + [claim])
        out.append(line + owner_cell(st, owners.get(g, []), user_w) + " │ "
                   + owner_cell(st, current.get(g, []), user_w).rstrip())
    out.append(st.dim("active = share of minutes with util >= 5%.  users = processes in the last hour / right now;"))
    out.append(st.dim("containers are shown as ctr:<name>.  claimed by = `gpumon take` (a notice, not enforced)."))
    for label, span in (("Last hour", 3600), ("Last 24 hours", 86400), ("Last 7 days", 7 * 86400)):
        out.append("")
        out += heatmap(st, db, gpus, info, end - span, end, "util", width, "%s - GPU utilization" % label,
                       occupancy=True, claims=claims)
    out.append("")
    out.append(st.dim("scale: 0% ") + st.legend() + st.dim(" 100%    · = no data"))
    out.append(st.dim("0 = unused (no process, <5% util, <1 GiB); anything in use shows as at least 1%."))
    out.append(st.dim("claim: gpumon take 0,1 [--for HOURS]  |  release: gpumon release 0,1  |  live: gpumon watch"))
    return out


def run_view(args, renderer):
    st = Style()
    if not args.watch:
        print("\n".join(renderer(args, st)))
        return 0
    try:
        while True:
            lines = renderer(args, st)
            sys.stdout.write("\033[H\033[2J" + "\n".join(lines) + "\n" +
                             st.dim("refreshing once a minute - Ctrl-C to quit"))
            sys.stdout.flush()
            # Redraw just after the collector writes each minute's row.
            time.sleep(WATCH_INTERVAL - time.time() % WATCH_INTERVAL + 3)
    except KeyboardInterrupt:
        print()
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="gpumon", description="GPU usage and claims on this machine.",
                                formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog="examples:\n  gpumon\n  gpumon watch\n  gpumon take 0,1,2\n"
                                       "  gpumon take 3 --for 8\n  gpumon release 0,1,2")
    p.add_argument("--version", action="version", version="gpumon " + VERSION)
    p.set_defaults(func=lambda a: run_view(a, render_overview), watch=False)
    sub = p.add_subparsers(dest="cmd", metavar="{watch,take,release}")

    sp = sub.add_parser("watch", help="the overview, redrawn once a minute")
    sp.set_defaults(func=lambda a: run_view(a, render_overview), watch=True)

    sp = sub.add_parser("take", help="mark GPUs as claimed by you (shown in the overview only)")
    sp.add_argument("gpus", help="GPUs to claim, e.g. 0,1,2 or 4-7")
    sp.add_argument("--for", dest="hours", type=float, default=CLAIM_DEFAULT_HOURS, metavar="HOURS",
                    help="how long (default %d, max %d)" % (CLAIM_DEFAULT_HOURS, CLAIM_MAX_HOURS))
    sp.set_defaults(func=cmd_take)

    sp = sub.add_parser("release", help="drop your claim on GPUs now")
    sp.add_argument("gpus", help="GPUs to release, e.g. 0,1,2")
    sp.set_defaults(func=cmd_release)

    sp = sub.add_parser("collect")  # run by the gpumon systemd service
    sp.add_argument("--interval", type=int, default=SAMPLE_INTERVAL)
    sp.add_argument("-f", "--foreground", action="store_true", help="also log to stderr")
    sp.add_argument("-q", "--quiet", action="store_true", help="say nothing if already running")
    sp.set_defaults(func=cmd_collect)

    args = p.parse_args(sys.argv[1:] if argv is None else argv)
    try:
        return args.func(args) or 0
    except BrokenPipeError:
        return 0
    except sqlite3.OperationalError as e:
        sys.exit("gpumon: database error: %s" % e)


if __name__ == "__main__":
    sys.exit(main())
